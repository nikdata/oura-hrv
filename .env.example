# Oura API credentials (from https://cloud.ouraring.com/v2/docs)
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret

# Oura OAuth tokens (get these by running scripts/oauth_bootstrap.py,
# or for local-only scripts like backfill.py / test_local.py, paste them here)
OURA_ACCESS_TOKEN=your-access-token
OURA_REFRESH_TOKEN=your-refresh-token

# Azure Key Vault URI (where Oura tokens are stored for the Function App)
KEY_VAULT_URI=https://ourahrv-kv.vault.azure.net/

# Azure Blob Storage (optional — defaults shown)
# BLOB_ACCOUNT_URL=https://ourahrvstore.blob.core.windows.net
# BLOB_CONTAINER_NAME=oura-data
